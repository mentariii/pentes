# ====================================================================
# KONFIGURASI DATABASE MYSQL (OPSIONAL)
# ====================================================================
# Jika variabel di bawah dikosongkan, Next.js akan otomatis menggunakan
# embedded in-memory database dengan data bawaan sehingga langsung siap
# dijalankan (zero-config) di lokal maupun Vercel!
#
# Untuk menghubungkan ke MySQL (misal di Aiven, TiDB Serverless, atau cPanel):
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306

# Secret key untuk sesi autentikasi
JWT_SECRET=super_secret_lab_key_ti_2026
